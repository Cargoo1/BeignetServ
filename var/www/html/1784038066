#include "../includes/Fdf.h"
#include <stdlib.h>

void	slope_bigger_than_1(t_img *image, int dx, int dy, int p)
{
	int	x;
	int	y;
	int	i;

	i = -1;
	x = image->point0.x;
	y = image->point0.y;
	while (++i < abs(dy))
	{
		my_put_pixel(image, x, y, calculate_gradient(y, image, 1));
		if (dy < 0)
			y -= 1;
		else
			y++;
		if (p < 0)
			p = p + (2 * abs(dx));
		else
		{
			p = p + (2 * abs(dx)) - (2 * abs(dy));
			if (dx < 0)
				x -= 1;
			else
				x++;
		}
	}
}

void	slope_less_than_1(t_img *image, int dx, int dy, int p)
{
	int	x;
	int	y;
	int	i;

	i = -1;
	x = image->point0.x;
	y = image->point0.y;
	while (++i < abs(dx))
	{
		my_put_pixel(image, x, y, calculate_gradient(x, image, 0));
		if (dx < 0)
			x -= 1;
		else
			x++;
		if (p < 0)
			p = p + (2 * abs(dy));
		else
		{
			p = p + (2 * abs(dy)) - (2 * abs(dx));
			if (dy < 0)
				y -= 1;
			else
				y++;
		}
	}
}

void	draw_algo(t_img *image)
{
	int	dx;
	int	dy;
	int	p;

	dx = (int)image->point1.x - (int)image->point0.x;
	dy = (int)image->point1.y - (int)image->point0.y;
	if (abs(dy) <= abs(dx))
	{
		p = 2 * abs(dy) - abs(dx);
		slope_less_than_1(image, dx, dy, p);
	}
	else
	{
		p = 2 * abs(dx) - abs(dy);
		slope_bigger_than_1(image, dx, dy, p);
	}
}
